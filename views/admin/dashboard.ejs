<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">MULTICOM</a>
        <div class="ms-auto d-flex align-items-center flex-wrap gap-2">
          <span class="text-white">Bienvenue <%= username %></span>
          <a class="btn btn-outline-light btn-sm" href="/admin/settings">Paramètres</a>
          <a class="btn btn-outline-light btn-sm" href="/admin/logout">Déconnexion</a>
        </div>
      </div>
    </nav>

    <div class="container py-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <div>
          <h2 class="fw-bold mb-1">Tableau de bord administrateur</h2>
          <p class="text-muted mb-0">Vue rapide des visiteurs enregistrés et des actions disponibles.</p>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
          <div class="card shadow-sm border-0 p-3">
            <h6 class="text-muted">Total visiteurs</h6>
            <div class="display-6 fw-bold"><%= stats.total %></div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card shadow-sm border-0 p-3">
            <h6 class="text-muted">Visiteurs du jour</h6>
            <div class="display-6 fw-bold"><%= stats.today %></div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card shadow-sm border-0 p-3">
            <h6 class="text-muted">Visiteurs du mois</h6>
            <div class="display-6 fw-bold"><%= stats.month %></div>
          </div>
        </div>
      </div>

      <form class="row g-2 mb-4" action="/admin/search" method="GET">
        <div class="col-12 col-md-8">
          <input class="form-control" name="q" placeholder="Rechercher par nom, email, téléphone ou pays" />
        </div>
        <div class="col-12 col-md-2">
          <button class="btn btn-primary w-100">Rechercher</button>
        </div>
        <div class="col-12 col-md-2">
          <a class="btn btn-outline-secondary w-100" href="/admin/export/excel">Exporter CSV</a>
        </div>
      </form>

      <div class="mb-3 d-flex flex-wrap gap-2">
        <a class="btn btn-outline-danger btn-sm" href="/admin/export/pdf">Exporter PDF</a>
      </div>

      <% if (dashboardError) { %>
        <div class="alert alert-warning"> <%= dashboardError %> </div>
      <% } %>
      <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
          <thead>
            <tr>
              <th>Nom</th>
              <th>Email</th>
              <th>Téléphone</th>
              <th>Pays</th>
              <th>Date</th>
              <th>IP</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (Array.isArray(visitors) && visitors.length) { %>
              <% visitors.forEach((visitor) => { %>
                <tr>
                  <td><%= visitor.full_name %></td>
                  <td><%= visitor.email %></td>
                  <td><%= visitor.phone %></td>
                  <td><%= visitor.country %></td>
                  <td><%= visitor.visited_at %></td>
                  <td><%= visitor.ip_address %></td>
                  <td>
                    <form method="POST" action="/admin/visitor/<%= visitor.id %>/delete" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center">Aucun visiteur trouvé.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
